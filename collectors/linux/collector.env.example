# ==============================================================================
# ThreatLens Linux Security Event Collector Configuration
# Copy this file to collector.env on your Arch Linux machine (Acer Predator):
#   cp collector.env.example collector.env
#   chmod 600 collector.env
# ==============================================================================

# Target ThreatLens Spring Boot Backend URL (MacBook Air IP and Port)
THREATLENS_BACKEND_URL=http://10.226.72.236:8080

# Dedicated Collector Authentication Credentials
# (Note: Provision a dedicated service account with the SECURITY_ANALYST role rather than admin)
COLLECTOR_USERNAME=collector_arch_predator
COLLECTOR_PASSWORD=your_secure_collector_password_here

# Source System Identifier (used by SIEM to track the reporting host)
COLLECTOR_SOURCE_SYSTEM=archlinux-predator

# Local Host Interface IP (Acer Predator IP)
COLLECTOR_HOST_IP=10.226.72.231

# Monitored systemd journal filters (comma-separated).
# ARCH LINUX JOURNAL FILTERING NOTE:
# On Arch Linux, sudo is an interactive setuid CLI binary, NOT a systemd daemon service
# (there is no sudo.service). Specifying 'sudo.service' causes journalctl to drop all sudo events.
# Recommended configuration: Leave EMPTY ("") to stream the full journal and rely on the
# Python parser's in-process filter for OpenSSH and Sudo events (including PAM and local TTYs).
# Alternatively, to filter at the journalctl command level using field matches:
# COLLECTOR_JOURNAL_UNITS=_COMM=sshd,+,_COMM=sudo
COLLECTOR_JOURNAL_UNITS=

# Persistent Journal Cursor State File
# (Maintains journalctl cursor across restarts to guarantee at-least-once delivery subject to
# systemd journal retention. Delivery is at-least-once: if the backend accepts an event but
# cursor persistence fails, retries will re-deliver the event, which may produce duplicate records
# in backend storage because neither ThreatLens backend nor MongoDB automatically deduplicates logs.)
COLLECTOR_STATE_FILE=collector_cursor.json

# Poison-Event Dead Letter Quarantine File
# (Stores events permanently rejected by backend schema validation [HTTP 400/422])
COLLECTOR_DEAD_LETTER_FILE=dead_letter.jsonl

# In-Memory Queue Buffer & Backpressure Limit
MAX_BUFFER_SIZE=1000

# Retry Delays
INITIAL_RETRY_DELAY_SECONDS=2.0
MAX_RETRY_DELAY_SECONDS=60.0
POLL_INTERVAL_SECONDS=1.0
