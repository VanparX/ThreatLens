# ==============================================================================
# ThreatLens Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your local or production setup.
# DO NOT commit real secrets or passwords to Git.
# ==============================================================================

# MongoDB Configuration
MONGO_ROOT_PASSWORD=ChangeMe!MongoPassword123
MONGO_URI=mongodb://threatlens_admin:ChangeMe!MongoPassword123@localhost:27018/threatlens?authSource=admin
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DATABASE=threatlens
MONGO_USERNAME=threatlens_admin
MONGO_PASSWORD=ChangeMe!MongoPassword123

# Server Configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Security
JWT_SECRET=ThreatLens-Super-Secret-Key-For-JWT-Authentication-2024-Capstone
JWT_EXPIRATION_MS=86400000

# Initial Admin User Provisioning (used only on first startup if user does not exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!Admin123
ADMIN_EMAIL=admin@threatlens.local

# ==============================================================================
# SMTP Outbound Email Notification Configuration
# ==============================================================================
# Configure these variables to deliver authentic HTML security advisories directly
# to on-duty security analysts when HIGH or CRITICAL threats are detected.
#
# Common SMTP Providers:
#   Gmail:       host=smtp.gmail.com, port=587, starttls=true (use an App Password)
#   Outlook/365: host=smtp.office365.com, port=587, starttls=true
#   Mailtrap:    host=sandbox.smtp.mailtrap.io, port=2525 (local testing sandbox)
#   Mailpit:     host=localhost, port=1025 (local developer mail catcher)
# ==============================================================================
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_SSL_ENABLE=false
SPRING_MAIL_TIMEOUT=5000
SPRING_MAIL_CONNECTION_TIMEOUT=5000

# Sender and Recipient Configuration
APP_MAIL_FROM=no-reply@threatlens.io
APP_MAIL_DEFAULT_RECIPIENT=soc-alerts@threatlens.io
